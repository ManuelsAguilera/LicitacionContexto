// Figura 4.11 de SD-04. Fuente de rejilla: diag-04-rejilla_layout.py genera el .dot con posiciones, que se dibuja con neato -n.
// Derivada de diag-04-04_emplazamientos-logicos.dot (borradores/); misma estructura, rótulos Azure (ADR-07).
digraph emplazamientos_logicos {
  graph [gxgaps="0:150,1:95", gygaps="0:58,1:70,2:70"];
  graph [rankdir=TB, bgcolor="white", pad="0.06", nodesep="0.25", ranksep="0.45", splines=true, forcelabels=true, newrank=true, fontname="Arial", fontsize=18, label="Emplazamientos lógicos para preparar la arquitectura física", labelloc=t];
  node [shape=box, style="rounded,filled", color="#33566B", penwidth=1.3, fillcolor="#EAF4FA", fontname="Arial", fontsize=16, margin="0.10,0.06"];
  edge [color="#667C8B", penwidth=1.3, arrowsize=0.72, fontname="Arial", fontsize=16];

  subgraph cluster_campo {
    label="Sedes operativas del Cliente"; color="#86B8A6"; style="rounded,filled"; fillcolor="#F3FAF7"; fontname="Arial"; fontsize=16;
    tiendas [gx=0, gy=0, label="SIT-01 · 22 tiendas ·\n11 regiones\nPOS, caché, diario y\nsincronizador\nAH-01/03/04/05/06/08/09/14", fillcolor="#D9F2E7"];
    cd_principal [gx=0, gy=1, label="CD-01 · CD principal\nRegión Metropolitana\nAH-07 · operación WMS\ndesde 2016\nenlace de dos proveedores", fillcolor="#D9F2E7"];
    cd_concepcion [gx=0, gy=2, label="CD-02 · CD Concepción\nAH-07 · planillas en\nconvivencia sin WMS\nacreditado · enlace único", fillcolor="#D9F2E7"];
    
  }

  subgraph cluster_matriz {
    label="Casa matriz · instalaciones existentes"; color="#ADB6BD"; style="rounded,filled"; fillcolor="#F7F8F8"; fontname="Arial"; fontsize=16;
    dc [gx=1, gy=0, label="DC-01 · Centro de datos\npropio · 140 m²\nservidores y plataformas\nalojadas: por inventariar", fillcolor="#ECEFF1"];
    respaldo [gx=2, gy=0, label="DC-02 · Sala de respaldo\nmisma comuna ·\nbrecha por evaluar", fillcolor="#ECEFF1"];
    dc -> respaldo [label="relación\nexistente;\ncapacidad por\nverificar", style=dotted, arrowhead=none];
  }

  subgraph cluster_nube {
    label="Microsoft Azure · carga nueva principal"; color="#83BBD6"; style="rounded,filled"; fillcolor="#F3F9FC"; fontname="Arial"; fontsize=16;
    primaria [gx=2, gy=1, label="CLD-01 · Azure Chile Central\nregión primaria · borde y\nAPI Management Retail/Emisor\nservicios en AKS · Event Hubs\nPremium · datos y BI separados", fillcolor="#D8EAF8"];
    dr [gx=2, gy=2, label="CLD-02 · Azure Brazil South\nregión de recuperación\nréplica y conmutación\npor componente ·\nresidencia por aprobar", fillcolor="#D8EAF8"];
    primaria -> dr [label="DR propuesto\nprueba y residencia", style=dashed, color="#3985B0"];
  }

  ext [gx=1, gy=3, label="Plataformas actuales AS-01\na AS-05, AS-09 a AS-11:\nERP/DTE · WMS · marketplace ·\ncomercio electrónico ·\nfidelización · Retail 2009 ·\ncrédito 2011 · remuneraciones\nALOJAMIENTO INDIVIDUAL\nDESCONOCIDO", fillcolor="#FFF2D7", color="#A3812E"];
  filial [gx=0, gy=3, label="Filial emisora = entidad\njurídica y ámbito de datos;\nNO es un lugar: comparte\nhoy red y centro de datos", fillcolor="#E9E1F5", color="#76559A"];
  leyenda [gx=2, gy=3, label="Enlaces discontinuos: rutas\ncandidatas, NO topología WAN\nacreditada. CD = centro de\ndistribución; centro de datos =\ninstalación informática. Cada\nruta requiere levantamiento de\nred, latencia, seguridad y\nresidencia.", shape=note, fillcolor="#FFF9E8", color="#C9A954", fontsize=16];

  tiendas -> primaria [label="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  tiendas -> dc [label="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  cd_principal -> primaria [label="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  cd_concepcion -> primaria [label="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  dc -> primaria [label="conectividad híbrida\npor diseñar", style=dashed, color="#8B8B8B"];
  ext -> dc [label="solo si inventario\nlo acredita", style=dashed, color="#A3812E", constraint=false];
  ext -> primaria [label="integración según\nalojamiento real", style=dashed, color="#A3812E", constraint=false];
  

  tiendas [pos="108.5,-51.2"];
  cd_principal [pos="108.5,-211.6"];
  cd_concepcion [pos="108.5,-384.0"];
  dc [pos="491.1,-51.2"];
  respaldo [pos="833.0,-51.2"];
  primaria [pos="833.0,-211.6"];
  dr [pos="833.0,-384.0"];
  ext [pos="491.1,-584.5"];
  filial [pos="108.5,-584.5"];
  leyenda [pos="833.0,-584.5"];
  subgraph cluster_campo { bb="-22.3,-433.8,239.2,39.0"; }
  subgraph cluster_matriz { bb="387.4,-101.0,938.9,29.6"; }
  subgraph cluster_nube { bb="655.6,-443.2,1010.4,-121.4"; }
  graph [margin=0, bb="-28.3,-669.8,1016.4,45.0"];
}
