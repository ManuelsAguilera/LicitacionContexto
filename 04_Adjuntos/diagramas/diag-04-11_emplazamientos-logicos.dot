// Figura 4.11 de SD-04. Fuente reproducible: dot -Tpdf / -Tsvg (Graphviz).
// Derivada de diag-04-04_emplazamientos-logicos.dot (borradores/); misma estructura, rótulos Azure (ADR-07).
digraph emplazamientos_logicos {
  graph [rankdir=TB, bgcolor="white", pad="0.06", nodesep="0.25", ranksep="0.45", splines=polyline, forcelabels=true, newrank=true, fontname="Arial", fontsize=18, label="Emplazamientos lógicos para preparar la arquitectura física", labelloc=t];
  node [shape=box, style="rounded,filled", color="#33566B", penwidth=1.3, fillcolor="#EAF4FA", fontname="Arial", fontsize=15, margin="0.10,0.06"];
  edge [color="#667C8B", penwidth=1.3, arrowsize=0.72, fontname="Arial", fontsize=15];

  subgraph cluster_campo {
    label="Sedes operativas del Cliente"; color="#86B8A6"; style="rounded,filled"; fillcolor="#F3FAF7"; fontname="Arial"; fontsize=16;
    tiendas [label="SIT-01 · 22 tiendas · 11 regiones\nPOS, caché, diario y relay local\nAH-01/03/04/05/06/08/09/14", fillcolor="#D9F2E7"];
    cd_principal [label="CD-01 · CD principal\nRegión Metropolitana\nAH-07 · operación WMS desde 2016\nenlace de dos proveedores", fillcolor="#D9F2E7"];
    cd_concepcion [label="CD-02 · CD Concepción\nAH-07 · planillas en convivencia\nsin WMS acreditado · enlace único", fillcolor="#D9F2E7"];
    tiendas -> cd_principal -> cd_concepcion [style=invis];
  }

  subgraph cluster_matriz {
    label="Casa matriz · instalaciones existentes"; color="#ADB6BD"; style="rounded,filled"; fillcolor="#F7F8F8"; fontname="Arial"; fontsize=16;
    dc [label="DC-01 · Centro de datos propio · 140 m²\nservidores y plataformas alojadas:\npor inventariar", fillcolor="#ECEFF1"];
    respaldo [label="DC-02 · Sala de respaldo\nmisma comuna · brecha por evaluar", fillcolor="#ECEFF1"];
    dc -> respaldo [xlabel="relación existente\ncapacidad por verificar", style=dotted, arrowhead=none];
  }

  subgraph cluster_nube {
    label="Microsoft Azure · carga nueva principal"; color="#83BBD6"; style="rounded,filled"; fillcolor="#F3F9FC"; fontname="Arial"; fontsize=16;
    primaria [label="CLD-01 · Azure Chile Central\nregión primaria · borde y\nAPI Management Retail/Emisor\nservicios en AKS · Event Hubs\nPremium · datos y BI separados", fillcolor="#D8EAF8"];
    dr [label="CLD-02 · Azure Brazil South\nregión de recuperación\nréplica y conmutación por\ncomponente · residencia por aprobar", fillcolor="#D8EAF8"];
    primaria -> dr [label="DR propuesto\nprueba y residencia", style=dashed, color="#3985B0"];
  }

  ext [label="Plataformas actuales AS-01 a AS-05,\nAS-09 a AS-11: ERP/DTE · WMS ·\nmarketplace · comercio electrónico ·\nfidelización · Retail 2009 · crédito\n2011 · remuneraciones\nALOJAMIENTO INDIVIDUAL DESCONOCIDO", fillcolor="#FFF2D7", color="#A3812E"];
  filial [label="Filial emisora = entidad jurídica\ny ámbito de datos; NO es un lugar:\ncomparte hoy red y centro de datos", fillcolor="#E9E1F5", color="#76559A"];
  leyenda [label="Enlaces discontinuos: rutas candidatas,\nNO topología WAN acreditada.\nCD = centro de distribución;\ncentro de datos = instalación informática.\nCada ruta requiere levantamiento de red,\nlatencia, seguridad y residencia.", shape=note, fillcolor="#FFF9E8", color="#C9A954", fontsize=14];

  tiendas -> primaria [xlabel="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  tiendas -> dc [xlabel="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  cd_principal -> primaria [xlabel="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  cd_concepcion -> primaria [xlabel="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  dc -> primaria [xlabel="conectividad híbrida por diseñar", style=dashed, color="#8B8B8B"];
  ext -> dc [xlabel="solo si inventario lo acredita", style=dashed, color="#A3812E", constraint=false];
  ext -> primaria [xlabel="integración según alojamiento real", style=dashed, color="#A3812E", constraint=false];
  primaria -> ext [style=invis]; dr -> filial [style=invis]; dr -> leyenda [style=invis]; {rank=same; ext; filial; leyenda;}
}
