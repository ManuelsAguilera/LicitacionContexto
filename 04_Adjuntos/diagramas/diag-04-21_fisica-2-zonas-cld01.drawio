ertex="1" parent="1"><mxGeometry x="1868" y="1185" width="46" height="46" as="geometry"/></mxCell><mxCell id="n54" value="DDoS, NAT y DNS privado" style="image;aspect=fixed;html=1;image=img/lib/azure2/networking/DDoS_Protection_Plans.svg;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=4;fontFamily=Helvetica;fontSize=21;fontColor=#1F1F1F;" vertex="1" parent="1"><mxGeometry x="1868" y="1265" width="46" height="46" as="geometry"/></mxCell><mxCell id="z55" value="Prueba de falla: cae la Zona 1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=4;spacingLeft=10;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#1F1F1F;strokeColor=#0078D4;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="20" y="1390" width="2410" height="200" as="geometry"/></mxCell><mxCell id="t56" value="AKS sigue en dos zonas: Retail al 93 %, Emisor al 81 % y base tecnológica al 66 % de uso en el peak, y escala hasta su máximo.   PostgreSQL promueve la espera de la Zona 2 en 60 a 120 s, sin pérdida de datos.   API Management y App Gateway atienden desde las otras zonas.   Event Hubs, Redis, Key Vault y Firewall no pierden datos.   El FortiGate pasivo de la Zona 2 asume los túneles en segundos." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#1F1F1F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1438" width="2370" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>