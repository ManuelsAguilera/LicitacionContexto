incipal." style="text;html=0;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1740" y="2412" width="599.1" height="26" /></mxCell><mxCell id="text14" value="Su bitácora no alimenta una analítica conjunta." style="text;html=0;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1740" y="2452" width="514.14" height="26" /></mxCell><mxCell id="text15" value="Catálogo y búsqueda de negocio: índices distintos." style="text;html=0;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1740" y="2591" width="575.5" height="27" /></mxCell><mxCell id="text16" value="Modelo de representaciones multimodales por seleccionar." style="text;html=0;align=left;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1740" y="2632" width="609.7199999999999" height="26" /></mxCell><mxCell id="text17" value="Leyenda" style="text;html=0;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="142" width="81.08" height="24" /></mxCell><mxCell id="text18" value="API / consulta" style="text;html=0;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="260" y="142" width="147.16" height="24" /></mxCell><mxCell id="text19" value="Datos propios" style="text;html=0;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="142" width="137.72" height="24" /></mxCell><mxCell id="text20" value="Publicación" style="text;html=0;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1340" y="142" width="118.83999999999999" height="24" /></mxCell><mxCell id="text21" value="Consumo" style="text;html=0;align=left;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1880" y="142" width="81.08" height="24" /></mxCell><mxCell id="text22" value="Política / gobierno" style="text;html=0;align=left;fontSize=16;fontStyle=1;"