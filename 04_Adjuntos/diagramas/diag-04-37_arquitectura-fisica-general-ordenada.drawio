calLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;spacingTop=-2;" vertex="1" parent="1"><mxGeometry x="740" y="1456" width="40" height="40" as="geometry"/></mxCell><mxCell id="n_internet" value="Internet&#xa;Salida invitados" style="aspect=fixed;html=1;fillColor=#005073;strokeColor=none;shape=mxgraph.azure.cloud;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;spacingTop=-2;" vertex="1" parent="1"><mxGeometry x="860" y="1456" width="40" height="40" as="geometry"/></mxCell><mxCell id="n_cam" value="Cámaras IP&#xa;Segmento CCTV&#xa;VLAN 50" style="aspect=fixed;html=1;fillColor=#005073;strokeColor=#FFFFFF;shape=mxgraph.cisco.computers_and_peripherals.video_camera;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;spacingTop=-2;" vertex="1" parent="1"><mxGeometry x="1010" y="1456" width="40" height="40" as="geometry"/></mxCell><mxCell id="n_nvr" value="NVR local&#xa;Retención 30 días" style="aspect=fixed;html=1;fillColor=#005073;strokeColor=#FFFFFF;shape=mxgraph.cisco.servers.storage_server;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;spacingTop=-2;" vertex="1" parent="1"><mxGeometry x="1130" y="1456" width="40" height="40" as="geometry"/></mxCell><mxCell id="n_gen" value="Generador / fuente&#xa;edificio 24 h&#xa;esenciales, por sitio" style="aspect=fixed;html=1;fillColor=#8A5A2B;strokeColor=#FFFFFF;shape=mxgraph.cisco.misc.ups;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;spacingTop=-2;" vertex="1" parent="1"><mxGeometry x="1330" y="1456" width="40" height="40" as="geometry"/></mxCell><mxCell id="n_ats" value="ATS / tableros A-B&#xa;Transferencia&#xa;supervisada" style="aspect=fixed;html=1;fillColor=#8A5A2B;strokeColor=#FFFFFF;shape=mxgraph.cisco.misc.ups;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;spacingTop=-2;" vertex="1" parent="1"><mxGeometry x="1490" y="1456" width="40" height="40" as="geometry"/></mxCell><mxCell id="n_ups" value="UPS A/B online&#xa;30 min a plena carga" style="aspect=fixed;html=1;fillColor=#8A5A2B;strokeColor=#FFFFFF;shape=mxgraph.cisco.misc.ups;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;spacingTop=-2;" vertex="1" parent="1"><mxGeometry x="1650" y="1456" width="40" height="40" as="geometry"/></mxCell><mxCell id="n_pdu" value="PDU A/B por rack&#xa;A hosts y equipos&#xa;de red" style="aspect=fixed;html=1;fillColor=#8A5A2B;strokeColor=#FFFFFF;shape=mxgraph.cisco.misc.ups;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=11;fontColor=#1A1A1A;fontFamily=Helvetica;spacingTop=-2;" vertex="1" parent="1"><mxGeometry x="1810" y="1456" width="40" height="40" as="geometry"/></mxCell><mxCell id="titulo" value="Arquitectura física general · nube y sitios Ancoa" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="520" y="6" width="1000" height="26" as="geometry"/></mxCell><mxCell id="subtitulo" value="Chile Central: producción · Brazil South: recuperación · Cuatro hosts por tienda · Redes Retail / Filial separadas" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="1000" height="18" as="geometry"/></mxCell><mxCell id="pie" value="Retail: azul · Filial: violeta · Cruce X-01: naranja · Administración y operación: gris discontinuo · Identidad: azul oscuro punteado · Copias/DR: verde azulado discontinuo · Energía: marrón punteado · Front Door→Application Gateway: Private Link propio / HTTPS&#xa;Los marcos identifican sitios y segmentos reales; VLAN/VRF más firewall e identidad definen los límites. No hay acceso libre R↔F. Pares locales y equipos LAN/SD-WAN: Cisco. PaaS y AKS: Azure. Símbolos agrupados por ámbito, sin prescribir fabricante del hardware.&#xa;Invitados: solo Internet. CCTV: NVR local. IoT: solo contrato Pedidos. Generador→ATS→UPS→PDU es suministro eléctrico, no ruta IP.&#xa;Fuente: elaboración propia desde Bases, Caso 09, inventario y decisiones del usuario. Uso de IA Alto. Diseño sujeto a pruebas; no es despliegue acreditado." style="text;html=1;align=center;verticalAlign=top;fontSize=10;fontFamily=Helvetica;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="220" y="1588" width="1600" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>