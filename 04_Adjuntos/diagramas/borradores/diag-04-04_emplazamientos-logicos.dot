digraph emplazamientos_logicos {
  graph [rankdir=TB, bgcolor="white", pad="0.38", nodesep="0.55", ranksep="0.9", splines=polyline, fontname="DejaVu Sans", fontsize=16, label="Emplazamientos lógicos para preparar la arquitectura física", labelloc=t];
  node [shape=box, style="rounded,filled", color="#33566B", penwidth=1.3, fillcolor="#EAF4FA", fontname="DejaVu Sans", fontsize=11, margin="0.18,0.13"];
  edge [color="#667C8B", penwidth=1.3, arrowsize=0.72, fontname="DejaVu Sans", fontsize=9];

  subgraph cluster_campo {
    label="Sedes operativas del Cliente"; color="#86B8A6"; style="rounded,filled"; fillcolor="#F3FAF7"; fontname="DejaVu Sans"; fontsize=13;
    tiendas [label="22 tiendas · 11 regiones\nPOS, caché, diario y relay local\nAH-01/03/04/05/06/08/09/14", fillcolor="#D9F2E7"];
    cd_principal [label="CD principal · Región Metropolitana\nAH-07 · operación WMS desde 2016\nenlace de dos proveedores", fillcolor="#D9F2E7"];
    cd_concepcion [label="CD Concepción\nAH-07 · planillas en convivencia\nsin WMS acreditado · enlace único", fillcolor="#D9F2E7"];
    tiendas -> cd_principal -> cd_concepcion [style=invis];
  }

  subgraph cluster_matriz {
    label="Casa matriz · instalaciones existentes"; color="#ADB6BD"; style="rounded,filled"; fillcolor="#F7F8F8"; fontname="DejaVu Sans"; fontsize=13;
    dc [label="Centro de datos propio · 140 m²\nservidores y plataformas alojadas: por inventariar", fillcolor="#ECEFF1"];
    respaldo [label="Sala de respaldo\nmisma comuna · brecha por evaluar", fillcolor="#ECEFF1"];
    dc -> respaldo [label="relación existente\ncapacidad por verificar", style=dotted, arrowhead=none];
  }

  subgraph cluster_nube {
    label="Nube pública · carga nueva principal"; color="#83BBD6"; style="rounded,filled"; fillcolor="#F3F9FC"; fontname="DejaVu Sans"; fontsize=13;
    primaria [label="Región primaria candidata: Santiago\nborde y gateways Retail/Emisor\nservicios, broker central candidato\ndatos y BI separados", fillcolor="#D8EAF8"];
    dr [label="Región de recuperación candidata\nréplica y conmutación por componente\nresidencia por aprobar", fillcolor="#D8EAF8"];
    primaria -> dr [label="DR propuesto\nprueba y residencia", style=dashed, color="#3985B0"];
  }

  ext [label="Plataformas actuales AS-01 a AS-05, AS-09 a AS-11\nERP/DTE · WMS · marketplace · ecommerce · fidelización\nRetail 2009 · crédito 2011 · remuneraciones\nALOJAMIENTO INDIVIDUAL DESCONOCIDO", fillcolor="#FFF2D7", color="#A3812E"];
  filial [label="Filial emisora = entidad jurídica y ámbito de datos\nNO es un lugar; comparte hoy red y centro de datos", fillcolor="#E9E1F5", color="#76559A"];
  leyenda [label="Enlaces discontinuos: rutas candidatas, NO topología WAN acreditada.\nCD = centro de distribución; centro de datos = instalación informática.\nCada ruta requiere levantamiento de red, latencia, seguridad y residencia.", shape=note, fillcolor="#FFF9E8", color="#C9A954", fontsize=10];

  tiendas -> primaria [label="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  tiendas -> dc [label="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  cd_principal -> primaria [label="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  cd_concepcion -> primaria [label="ruta por verificar", style=dashed, color="#8B8B8B", constraint=false];
  dc -> primaria [label="conectividad híbrida por diseñar", style=dashed, color="#8B8B8B"];
  ext -> dc [label="solo si inventario lo acredita", style=dashed, color="#A3812E", constraint=false];
  ext -> primaria [label="integración según alojamiento real", style=dashed, color="#A3812E", constraint=false];
  primaria -> ext -> filial -> leyenda [style=invis];
}
