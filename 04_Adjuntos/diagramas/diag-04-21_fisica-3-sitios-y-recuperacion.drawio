dFill=1;endSize=6;fontFamily=Helvetica;fontSize=21;fontColor=#1F1F1F;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n30"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1740" y="425.0"/><mxPoint x="1740" y="975.0"/></Array></mxGeometry></mxCell><mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0078D4;strokeWidth=2.5;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=21;fontColor=#1F1F1F;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n26" target="n31"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1730" y="525.0"/><mxPoint x="1730" y="1085.0"/></Array></mxGeometry></mxCell><mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0078D4;strokeWidth=2.5;endArrow=block;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=21;fontColor=#1F1F1F;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n27" target="n32"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1720" y="625.0"/><mxPoint x="1720" y="1185.0"/></Array></mxGeometry></mxCell><mxCell id="z48" value="Replicación (da disponibilidad)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=4;spacingLeft=10;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#1F1F1F;strokeColor=#0078D4;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1750" y="20" width="760" height="450" as="geometry"/></mxCell><mxCell id="t49" value="• Entre zonas, síncrona: PostgreSQL primario Z1 → espera Z2, conmutación en 60 a 120 s sin pérdida; Event Hubs con 3 copias.&#xa;• Entre regiones, asíncrona: PostgreSQL con retraso medido y alertado (RT-07.03); Event Hubs con retraso máximo &lt; 15 min; registro de imágenes y almacenamiento copiados.&#xa;• Emisor hacia CLD-02 solo si el Cliente aprueba la residencia; si no, su copia queda en DC-02.&#xa;• Objetivo: RPO ≤ 15 min y RTO ≤ 4 h (RT-07.04)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#1F1F1F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1770" y="70" width="720" height="270" as="geometry"/></mxCell><mxCell id="z50" value="Respaldo 3-2-1-1-0 (protege contra pérdida y ransomware)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=4;spacingLeft=10;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#1F1F1F;strokeColor=#0078D4;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1750" y="500" width="760" height="450" as="geometry"/></mxCell><mxCell id="t51" value="• 3 copias: producción, bóveda de CLD-01 y bóveda de CLD-02.&#xa;• 2 medios: almacenamiento de Azure y cinta en custodia de DC-01.&#xa;• 1 fuera del sitio: CLD-02 (o DC-02 para el Emisor sin residencia aprobada).&#xa;• 1 inmutable: la bóveda; borrar exige una segunda persona.&#xa;• 0 errores: restauración de prueba mensual con tiempo medido (RT-07.12)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#1F1F1F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1770" y="550" width="720" height="220" as="geometry"/></mxCell><mxCell id="z52" value="Conmutación a CLD-02, activo-pasivo" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=4;spacingLeft=10;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#1F1F1F;strokeColor=#0078D4;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1750" y="980" width="760" height="300" as="geometry"/></mxCell><mxCell id="t53" value="1 declarar contingencia · 2 promover Event Hubs · 3 promover PostgreSQL y habilitar HA · 4 crear AKS por IaC · 5 activar el origen de Brazil South en Front Door · 6 conciliar diarios de tienda. Ensayo dos veces al año; las tiendas venden durante todo el proceso." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=21;fontColor=#1F1F1F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1770" y="1030" width="720" height="150" as="geometry"/></mxCell><mxCell id="t54" value="Leyenda" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=23;fontColor=#1F1F1F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1750" y="1300" width="760" height="34" as="geometry"/></mxCell><mxCell id="z55" value="" style="rounded=1;html=1;strokeColor=#0078D4;strokeWidth=2;fillColor=#EEF5FC;" vertex="1" parent="1"><mxGeometry x="1750" y="1344" width="46" height="30" as="geometry"/></mxCell><mxCell id="t56" value="Only Simple Solutions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#1F1F1F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1808" y="1338" width="702" height="44" as="geometry"/></mxCell><mxCell id="z57" value="" style="rounded=1;html=1;strokeColor=#2E7D32;strokeWidth=2;fillColor=#EEF7EF;" vertex="1" parent="1"><mxGeometry x="1750" y="1388" width="46" height="30" as="geometry"/></mxCell><mxCell id="t58" value="Cliente" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#1F1F1F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1808" y="1382" width="702" height="44" as="geometry"/></mxCell><mxCell id="z59" value="" style="rounded=1;html=1;strokeColor=#C55A11;strokeWidth=2;fillColor=#FDF1E7;" vertex="1" parent="1"><mxGeometry x="1750" y="1432" width="46" height="30" as="geometry"/></mxCell><mxCell id="t60" value="Terceros" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#1F1F1F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1808" y="1426" width="702" height="44" as="geometry"/></mxCell><mxCell id="e61" style="endArrow=block;endFill=1;html=1;strokeColor=#1F1F1F;strokeWidth=2.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1750" y="1491" as="sourcePoint"/><mxPoint x="1796" y="1491" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t62" value="Propuesto o respaldo" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#1F1F1F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1808" y="1470" width="702" height="44" as="geometry"/></mxCell><mxCell id="e63" style="endArrow=block;endFill=1;html=1;strokeColor=#0078D4;strokeWidth=2.5;dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1750" y="1535" as="sourcePoint"/><mxPoint x="1796" y="1535" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t64" value="Réplica entre regiones" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=19;fontColor=#1F1F1F;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1808" y="1514" width="702" height="44" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>