// Figura 4.12 de SD-04. Fuente reproducible: dot -Tpdf / -Tsvg (Graphviz).
// Derivada de diag-04-05_datos-y-frontera.dot (borradores/); misma estructura, productos Azure en rótulos de datos.
digraph datos_y_frontera {
  graph [rankdir=TB, bgcolor="white", pad="0.06", nodesep="0.16", ranksep="0.16", splines=polyline, forcelabels=true, newrank=true,
    fontname="Arial", fontsize=18, label="Datos y frontera Retail–Filial emisora", labelloc=t];
  node [shape=box, style="rounded,filled", color="#33566B", penwidth=1.2, fillcolor="#EAF4FA",
    fontname="Arial", fontsize=15, margin="0.10,0.06"];
  edge [color="#667C8B", penwidth=1.25, arrowsize=0.7, fontname="Arial", fontsize=15];

  subgraph cluster_retail {
    label="RETAIL · autoridad comercial"; labelloc=t; color="#68A894"; style="rounded,filled";
    fillcolor="#F0FAF6"; fontname="Arial"; fontsize=16;
    ventas [label="R:V-02 · Ventas / POS\nventa y referencia\nde compra", fillcolor="#D8F1E7"];
    cliente [label="R:CL-02 · Clientes Retail\nidentidad comercial\ny preferencias", fillcolor="#D8F1E7"];
    stock [label="R:M-03 · Existencias\nconteos, ajustes y disponible", fillcolor="#D8F1E7"];
    datos_r [label="PostgreSQL Retail\nuna base por autoridad", shape=cylinder, fillcolor="#DDF1E8"];
    ml_conteo [label="ML · predicción de\nconteos y margen\nrecomendado", fillcolor="#E7F5D9"];
    ml_merma [label="ML · clasificación\nde merma: causa con\nevidencia; sin ajuste\nautomático", fillcolor="#E7F5D9"];
    lago_r [label="Data Lake Retail\nconjuntos comerciales\nautorizados", shape=cylinder, fillcolor="#DDF1E8"];
    bi_r [label="Power BI Retail\ntableros por rol", fillcolor="#D8F1E7"];
    marketing [label="Marketing\nsegmentación comercial", fillcolor="#FFF0DC", color="#B68A45"];

    ventas -> datos_r [xlabel="escribe venta"];
    cliente -> datos_r [xlabel="escribe perfil"];
    stock -> datos_r [xlabel="escribe\nstock"];
    datos_r -> lago_r [xlabel="proyección de lectura"];
    lago_r -> bi_r [xlabel="consulta"];
    lago_r -> ml_conteo [xlabel="historial depurado"];
    lago_r -> ml_merma [xlabel="conteos y diferencias"];
    ml_conteo -> stock [xlabel="recomendación;\naprobación humana", style=dashed, color="#6A8F39"];
    ml_merma -> stock [xlabel="sugerencia", style=dashed, color="#6A8F39"];
    marketing -> cliente [xlabel="preferencias permitidas"];
  }

  subgraph cluster_frontera {
    label="FRONTERA · política aplicada en ambos extremos"; labelloc=t; color="#C9A545";
    style="rounded,filled"; fillcolor="#FFF9E7"; fontname="Arial"; fontsize=16;
    x01 [label="X-01 · Gobierno de cruces\nficha: finalidad, base\ny mínimos; política,\ndecisión y auditoría", fillcolor="#FFF0B9", color="#AA832A"];
    contrato [label="Contrato de compra\ncon tarjeta: solo\nreferencia, importe\ny medio → ← decisión,\nreferencia y vigencia", fillcolor="#FFF2D4", color="#AA832A"];
    cruce_bi [label="Proyección BI cruzada\nDESHABILITADA\npor defecto; solo\nconjunto mínimo\naprobado", fillcolor="#FFF2D4", color="#AA832A"];
    bitacora [label="Bitácora de cruces\nseparada del\nexpediente financiero", shape=cylinder, fillcolor="#FFF2D4", color="#AA832A"];
    x01 -> bitacora [headlabel="registra permiso\no rechazo", labeldistance=4, labelangle=-70];
    x01 -> contrato [xlabel="habilita ficha y política", style=dotted, arrowhead=none];
    x01 -> cruce_bi [xlabel="solo tras aprobación", style=dotted, arrowhead=none];
  }

  subgraph cluster_emisor {
    label="FILIAL EMISORA · autoridad financiera separada"; labelloc=t; color="#8A72AE";
    style="rounded,filled"; fillcolor="#F7F3FB"; fontname="Arial"; fontsize=16;
    credito [label="F:C-01 · Originación\ny autorización\nsolicitud, cupo y decisión", fillcolor="#E9E0F4", color="#765C9B"];
    cartera [label="F:C-02 · Cartera\nsaldo, mora y cobranza", fillcolor="#E9E0F4", color="#765C9B"];
    evidencia [label="F:C-03 · Evidencia\nfinanciera: información,\naceptación y firma", fillcolor="#E9E0F4", color="#765C9B"];
    datos_f [label="PostgreSQL Emisor\nuna base por autoridad", shape=cylinder, fillcolor="#EDE5F6", color="#765C9B"];
    exp_f [label="Expediente financiero\ncustodia y\nretención propias", shape=cylinder, fillcolor="#EDE5F6", color="#765C9B"];
    lago_f [label="Data Lake Emisor\nconjuntos financieros\nautorizados", shape=cylinder, fillcolor="#EDE5F6", color="#765C9B"];
    bi_f [label="Power BI Emisor\ntableros por rol", fillcolor="#E9E0F4", color="#765C9B"];

    credito -> datos_f [xlabel="escribe decisión"];
    cartera -> datos_f [xlabel="escribe cartera"];
    evidencia -> exp_f [xlabel="custodia prueba"];
    credito -> evidencia [xlabel="verifica evidencia", style=dashed];
    datos_f -> lago_f [xlabel="proyección de lectura"];
    lago_f -> bi_f [xlabel="consulta"];
  }

  ventas -> contrato [xlabel="compra: datos mínimos", color="#21847B", penwidth=2];
  contrato -> credito [xlabel="solicitud y respuesta", dir=both, color="#21847B", penwidth=2];
  ventas -> x01 [xlabel="política Retail", style=dotted, arrowhead=none, constraint=false];
  credito -> x01 [xlabel="política\nEmisor", style=dotted, arrowhead=none, constraint=false];
  marketing -> cartera [headlabel="mora y pago:\nACCESO DENEGADO", labeldistance=7, labelangle=-30, labelfontcolor="#A93636", color="#BC4F4F", fontcolor="#A93636",
    style=dashed, arrowhead=tee, constraint=false];
  lago_f -> cruce_bi [xlabel="solo derivado\nmínimo", style=dashed, color="#AA832A", constraint=false];
  cruce_bi -> bi_r [xlabel="si ficha aprobada;\nauditable", style=dashed, color="#AA832A", constraint=false];

  leyenda [label="Continua: autoridad o consulta propia.\nAzul verdoso: compra autorizable.\nPunteado: control o flujo condicionado.\nRojo: solicitud denegada.\nSin repositorio común ni copia libre\nentre Retail y Emisor. ML recomienda;\nuna persona aprueba los ajustes.", shape=note,
    fillcolor="#F5F6F7", color="#9FA9B0", fontsize=15];
  stock -> leyenda [style=invis];
}
