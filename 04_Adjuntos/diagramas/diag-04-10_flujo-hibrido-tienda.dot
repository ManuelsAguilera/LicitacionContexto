// Figura 4.10 de SD-04. Fuente reproducible: dot -Tpdf / -Tsvg (Graphviz).
// Derivada de diag-04-03_flujo-hibrido.dot (borradores/); misma estructura, rótulos Azure (ADR-06, ADR-07).
digraph flujo_hibrido {
  graph [rankdir=TB, newrank=true, bgcolor="white", pad="0.06", nodesep="0.22", ranksep="0.32", splines=polyline, forcelabels=true, fontname="Arial", fontsize=18, label="Flujo lógico híbrido: tienda, nube y frontera Retail–Emisor", labelloc=t];
  node [shape=box, style="rounded,filled", color="#33566B", penwidth=1.3, fillcolor="#EAF4FA", fontname="Arial", fontsize=15, margin="0.10,0.06"];
  edge [color="#456579", penwidth=1.3, arrowsize=0.72, fontname="Arial", fontsize=15];

  subgraph cluster_tienda {
    label="Tienda · operación local durante 24 h"; color="#88B9A9"; style="rounded,filled"; fillcolor="#F3FAF7"; fontname="Arial"; fontsize=16;
    actor [label="AH-04 Cajero\nAH-03 Vendedor", shape=ellipse, fillcolor="white"];
    pos [label="POS nuevo\ninterfaz Retail", fillcolor="#D9F2E7"];
    cache [label="Caché local\noferta y existencia vigentes", fillcolor="#D9F2E7"];
    diario [label="Diario durable\nventa + hecho pendiente", fillcolor="#D9F2E7"];
    relay [label="Sincronizador\nreintento e idempotencia", fillcolor="#D9F2E7"];
    fin_actor [label="AH-02 Titular\nAH-10 Ejecutivo", shape=ellipse, fillcolor="white"];
    fin_ui [label="Sesión financiera\nrol e identidad separados", fillcolor="#E9E1F5", color="#76559A"];
    actor -> pos [xlabel="operación"];
    cache -> pos [xlabel="lectura local", constraint=false];
    pos -> diario [xlabel="sin enlace: registro local", color="#237F68"];
    diario -> relay [xlabel="pendientes", color="#237F68"];
    fin_actor -> fin_ui [xlabel="trámite"];
  }

  subgraph cluster_retail {
    label="Azure Chile Central · ámbito Retail"; color="#83BBD6"; style="rounded,filled"; fillcolor="#F3F9FC"; fontname="Arial"; fontsize=16;
    gateway_r [label="API Management Retail\nAPI y políticas", fillcolor="#D8EAF8"];
    venta [label="R:V-02 Ventas\nconciliación", fillcolor="#D9F2E7"];
    stock [label="R:M-03 Existencias\nreserva / disponible", fillcolor="#D9F2E7"];
    outbox [label="Outbox por productor\nhecho confirmado", fillcolor="#D8EAF8"];
    broker [label="Azure Event Hubs Premium\nhechos Retail segregados", fillcolor="#D8EAF8"];
    bi [label="Data Lake y Power BI\nRetail · solo lectura", fillcolor="#EAF4FA"];
    ml [label="ML conteo y merma\nrecomendaciones", fillcolor="#EAF4FA"];
    adapt [label="Adaptadores en AKS\nconfirmación y\nconciliación", fillcolor="#EEF1F5"];
    gateway_r -> stock [xlabel="reserva síncrona"];
    gateway_r -> venta [xlabel="venta síncrona"];
    venta -> stock [xlabel="efecto confirmado", style=dotted];
    venta -> outbox [xlabel="hecho de venta"];
    stock -> outbox [xlabel="movimiento confirmado"];
    outbox -> broker [xlabel="publicación/reintento"];
    broker -> bi [xlabel="proyección", color="#2C8297"];
    broker -> ml [xlabel="conteos/eventos", color="#2C8297"];
    venta -> adapt [xlabel="DTE / pagos", style=dashed];
    stock -> adapt [xlabel="WMS", style=dashed];
  }

  subgraph cluster_emisor {
    label="Filial emisora · ámbito lógico separado, no sitio"; color="#A892C3"; style="rounded,filled"; fillcolor="#F8F5FB"; fontname="Arial"; fontsize=16;
    gateway_f [label="API Management\nEmisor, roles propios", fillcolor="#E9E1F5", color="#76559A"];
    credito [label="F:C-01 Crédito\noriginación y\nautorización", fillcolor="#E9E1F5", color="#76559A"];
    evidencia [label="F:C-03 Evidencia\nexpediente\nfinanciero", fillcolor="#E9E1F5", color="#76559A"];
    x01 [label="X-01 Gobierno de cruces\nficha, mínimos y bitácora\ncontroles en\nambos extremos", fillcolor="#FFF0C2", color="#A17E2C"];
    gateway_f -> credito [xlabel="consulta autorizada", color="#76559A"];
    credito -> evidencia [xlabel="verificar prueba", color="#76559A"];
    x01 -> credito [style=dotted, arrowhead=none, color="#A17E2C"];
  }

  plataformas [label="Plataformas conservadas\nAS-01 ERP/DTE · AS-02 WMS\nubicación por verificar", fillcolor="#F0F0F0", color="#818181"];
  pos -> gateway_r [xlabel="con enlace", color="#237F68"];
  relay -> gateway_r [xlabel="al reconectar: entrega confirmada", color="#237F68", minlen=2];
  fin_ui -> gateway_f [xlabel="solo con enlace", color="#76559A"];
  venta -> credito [xlabel="autorización por compra\nsolo contrato aprobado", color="#A17E2C", style=dashed, constraint=false];
  x01 -> venta [style=dotted, arrowhead=none, color="#A17E2C", constraint=false];
  adapt -> plataformas [xlabel="interfaz por levantar", style=dashed, constraint=false];

  nota [label="Sólida: flujo propuesto\nDiscontinua: contrato o emplazamiento condicionado\nPunteada: política o efecto\nSin enlace no se originan tarjetas ni se amplían cupos;\nmodalidad tributaria local por aprobar.", shape=note, fillcolor="#FFF9E8", color="#C9A954", fontsize=15];
  evidencia -> nota [style=invis];
  nota -> plataformas [style=invis];
  {rank=same; gateway_r; gateway_f;}
}
