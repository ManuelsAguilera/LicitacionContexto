ometry as="geometry" x="2671.21" y="162" width="107.58" height="25" /></mxCell><mxCell id="text14" value="RETAIL" style="text;html=0;align=center;fontSize=19;fontColor=#1A1A1A;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="2160.37" y="255" width="79.25999999999999" height="26" /></mxCell><mxCell id="text15" value="FILIAL EMISORA" style="text;html=0;align=center;fontSize=19;fontColor=#1A1A1A;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="2115.53" y="1390" width="168.94" height="26" /></mxCell><mxCell id="text16" value="Innovaciones dentro de sus servicios responsables" style="text;html=0;align=left;fontSize=17;fontColor=#1A1A1A;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1445" y="918" width="503.46999999999997" height="24" /></mxCell><mxCell id="text17" value="Acceso directo a datos" style="text;html=0;align=left;fontSize=19;fontColor=#1A1A1A;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="2025" y="336" width="258.62" height="26" /></mxCell><mxCell id="text18" value="El canal de eventos no intermedia" style="text;html=0;align=left;fontSize=16;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2025" y="367" width="323.52" height="23" /></mxCell><mxCell id="text19" value="la persistencia de los servicios." style="text;html=0;align=left;fontSize=16;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2025" y="391" width="323.52" height="23" /></mxCell><mxCell id="text20" value="Salida transaccional por productor." style="text;html=0;align=left;fontSize=16;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2025" y="839" width="342.4" height="23" /></mxCell><mxCell id="text21" value="Consumo idempotente y reintentos." style="text;html=0;align=left;fontSize=16;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="2025" y="863" width="323.52" height="23" /></mxCell><mxCell id="tex