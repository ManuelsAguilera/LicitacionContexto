digraph escalera_calidad {
  graph [bgcolor="white", rankdir=TB, nodesep=0.12, ranksep=0.10, pad=0.08,
         fontname="Arial", newrank=true];
  node  [shape=plaintext, fontname="Arial", fontsize=13, fontcolor="#17324D", margin=0];
  edge  [fontname="Arial", fontsize=13, color="#17324D", fontcolor="#17324D"];

  // ---------- Encabezado de columnas ----------
  cab [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4">
      <TR><TD WIDTH="104" ALIGN="LEFT" BALIGN="LEFT" VALIGN="BOTTOM"><B>Quién controla<BR ALIGN="LEFT"/>la calidad<BR ALIGN="LEFT"/></B></TD><TD WIDTH="112" ALIGN="LEFT" BALIGN="LEFT" VALIGN="BOTTOM"><B>Quién valida y<BR ALIGN="LEFT"/>firma<BR ALIGN="LEFT"/></B></TD><TD WIDTH="180" ALIGN="LEFT" BALIGN="LEFT" VALIGN="BOTTOM"><B>Qué se mide<BR ALIGN="LEFT"/></B></TD><TD WIDTH="136" ALIGN="LEFT" BALIGN="LEFT" VALIGN="BOTTOM"><B>Si no se cumple<BR ALIGN="LEFT"/></B></TD></TR>
      <TR><TD COLSPAN="4" HEIGHT="2" CELLPADDING="0" BGCOLOR="#17324D"></TD></TR>
    </TABLE>>];

  // ---------- Escalones (3 arriba, 1 abajo; degradé #196197 -> #17324D) ----------
  e3 [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#17324D">
      <TR><TD COLSPAN="4" ALIGN="LEFT"><FONT COLOR="white"><B>Nivel 3 · Resultados de negocio</B></FONT></TD></TR>
      <TR><TD WIDTH="104" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">Equipo del<BR ALIGN="LEFT"/>proponente<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="112" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">El cliente juzga<BR ALIGN="LEFT"/>el éxito; la<BR ALIGN="LEFT"/>Contraparte<BR ALIGN="LEFT"/>Técnica lo<BR ALIGN="LEFT"/>formaliza en el<BR ALIGN="LEFT"/>acta<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="180" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">Los 28 resultados de<BR ALIGN="LEFT"/>negocio del Caso (Anexo D)<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="136" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">Plan de corrección<BR ALIGN="LEFT"/>con plazo, sin alterar<BR ALIGN="LEFT"/>los 56 meses<BR ALIGN="LEFT"/></FONT></TD></TR>
    </TABLE>>];

  e2 [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#184A72">
      <TR><TD COLSPAN="4" ALIGN="LEFT"><FONT COLOR="white"><B>Nivel 2 · Marcha blanca</B></FONT></TD></TR>
      <TR><TD WIDTH="104" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">Equipo del<BR ALIGN="LEFT"/>proponente<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="112" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">Contraparte<BR ALIGN="LEFT"/>Técnica (acta)<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="180" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">Condiciones del art. 17.3 de<BR ALIGN="LEFT"/>las Bases:<BR ALIGN="LEFT"/>• sin incidentes críticos ni<BR ALIGN="LEFT"/>   altos<BR ALIGN="LEFT"/>• volumen real en las cuatro<BR ALIGN="LEFT"/>   últimas semanas<BR ALIGN="LEFT"/>• conciliación sin diferencias<BR ALIGN="LEFT"/>   sin explicar<BR ALIGN="LEFT"/>• personal capacitado<BR ALIGN="LEFT"/>• posibilidad de volver atrás<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="136" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">Extensión de la<BR ALIGN="LEFT"/>marcha blanca a<BR ALIGN="LEFT"/>costo del proponente<BR ALIGN="LEFT"/>(multa de 1 % por<BR ALIGN="LEFT"/>semana, tope de<BR ALIGN="LEFT"/>10 %, si es<BR ALIGN="LEFT"/>imputable)<BR ALIGN="LEFT"/></FONT></TD></TR>
    </TABLE>>];

  e1 [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#196197">
      <TR><TD COLSPAN="4" ALIGN="LEFT"><FONT COLOR="white"><B>Nivel 1 · Entregable</B></FONT></TD></TR>
      <TR><TD WIDTH="104" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">Equipo del<BR ALIGN="LEFT"/>proponente<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="112" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">Contraparte<BR ALIGN="LEFT"/>Técnica (acta)<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="180" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">Criterio con hecho<BR ALIGN="LEFT"/>observable y umbral;<BR ALIGN="LEFT"/>artefacto, evidencia,<BR ALIGN="LEFT"/>trazabilidad y observaciones<BR ALIGN="LEFT"/>resueltas<BR ALIGN="LEFT"/></FONT></TD><TD WIDTH="136" ALIGN="LEFT" BALIGN="LEFT" VALIGN="TOP"><FONT COLOR="white">Nueva presentación:<BR ALIGN="LEFT"/>diez días hábiles<BR ALIGN="LEFT"/>para subsanar<BR ALIGN="LEFT"/></FONT></TD></TR>
    </TABLE>>];

  // ---------- Leyenda ----------
  leyenda [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#17324D">
      <TR>
        <TD BGCOLOR="#196197" WIDTH="18"><FONT COLOR="white"><B>1</B></FONT></TD>
        <TD BGCOLOR="#184A72" WIDTH="18"><FONT COLOR="white"><B>2</B></FONT></TD>
        <TD BGCOLOR="#17324D" WIDTH="18"><FONT COLOR="white"><B>3</B></FONT></TD>
        <TD ALIGN="LEFT" BALIGN="LEFT">Nivel: el número indica el orden;<BR ALIGN="LEFT"/>el tono oscurece hacia arriba<BR ALIGN="LEFT"/></TD>
        <TD ALIGN="LEFT" BALIGN="LEFT">▲ Sentido de ascenso<BR ALIGN="LEFT"/>entre niveles<BR ALIGN="LEFT"/></TD>
      </TR>
    </TABLE>>];

  // ---------- Flecha lateral (de abajo hacia arriba) ----------
  node [shape=point, width=0.01, style=invis, label=""];
  a3; a1;

  cab -> e3 -> e2 -> e1 -> leyenda [style=invis];

  { rank=same; e3; a3; }
  { rank=same; e1; a1; }
  e3 -> a3 [style=invis];
  e1 -> a1 [style=invis];

  a3 -> a1 [dir=back, penwidth=3, arrowtail=normal, arrowsize=1.4,
            label="  Superar un  \n  nivel no  \n  exime del  \n  siguiente  "];
}
