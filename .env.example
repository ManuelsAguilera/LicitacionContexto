# Variables de entorno para el MCP ragdocs (mcp-server-ragdocs).
#
# Copiar este archivo a .env y completar los valores. .env esta en .gitignore:
# nunca versionar claves reales.
#
# Referencia desde opencode.jsonc con el placeholder {env:NOMBRE}.

# --- Qdrant Cloud (obligatorio) ---
# Dashboard: https://cloud.qdrant.io -> crear cluster -> copiar URL y API key
QDRANT_URL=https://tu-cluster-xxxxx.eu-central.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=

# --- Embeddings (obligatorio) ---
# Proveedor: "openai" u "ollama".
#   openai: requiere OPENAI_API_KEY y paga por uso.
#   ollama: local y gratuito, pero requiere Ollama instalado con el modelo
#           descargado (ollama pull nomic-embed-text) y EMBEDDING_PROVIDER=ollama.
# Solo aplica si el proveedor elegido es ollama:
# OLLAMA_URL=http://localhost:11434
# EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
